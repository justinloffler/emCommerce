---
/**
 * ImageGallery — Product image gallery with thumbnail navigation.
 */
interface Props {
	images: Array<{ url: string; alt?: string }>;
	class?: string;
}

const { images, class: className = "" } = Astro.props;
const hasImages = images.length > 0;
---

<div class:list={["ec-gallery", className]}>
	{hasImages ? (
		<>
			<div class="ec-gallery__main">
				<img
					src={images[0].url}
					alt={images[0].alt ?? "Product image"}
					class="ec-gallery__image"
					data-gallery-main
				/>
			</div>
			{images.length > 1 && (
				<div class="ec-gallery__thumbs">
					{images.map((img, i) => (
						<button
							type="button"
							class:list={["ec-gallery__thumb", { "ec-gallery__thumb--active": i === 0 }]}
							data-gallery-idx={i}
						>
							<img src={img.url} alt={img.alt ?? `Thumbnail ${i + 1}`} loading="lazy" />
						</button>
					))}
				</div>
			)}
		</>
	) : (
		<div class="ec-gallery__placeholder">No image available</div>
	)}
</div>

<style>
	.ec-gallery {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.ec-gallery__main {
		aspect-ratio: 1;
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--ec-color-bg-muted, #f9fafb);
	}
	.ec-gallery__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ec-gallery__thumbs {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
	}
	.ec-gallery__thumb {
		width: 4rem;
		height: 4rem;
		border: 2px solid transparent;
		border-radius: 0.375rem;
		overflow: hidden;
		cursor: pointer;
		padding: 0;
		background: none;
		flex-shrink: 0;
	}
	.ec-gallery__thumb--active {
		border-color: var(--ec-color-primary, #2563eb);
	}
	.ec-gallery__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ec-gallery__placeholder {
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--ec-color-bg-muted, #f9fafb);
		border-radius: 0.5rem;
		color: var(--ec-color-muted, #6b7280);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>(".ec-gallery").forEach((gallery) => {
		const mainImg = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
		const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-idx]");

		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const img = thumb.querySelector("img");
				if (mainImg && img) {
					mainImg.src = img.src;
					mainImg.alt = img.alt;
					thumbs.forEach((t) => t.classList.remove("ec-gallery__thumb--active"));
					thumb.classList.add("ec-gallery__thumb--active");
				}
			});
		});
	});
</script>
