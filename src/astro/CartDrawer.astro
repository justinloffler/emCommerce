---
/**
 * CartDrawer — Slide-over cart panel.
 * Initialized via client-side JS, subscribes to cart state changes.
 */
interface Props {
	currencySymbol?: string;
	checkoutPath?: string;
	class?: string;
}

const {
	currencySymbol = "$",
	checkoutPath = "/checkout",
	class: className = "",
} = Astro.props;
---

<div class:list={["ec-cart-drawer", className]} data-cart-drawer data-currency={currencySymbol} data-checkout={checkoutPath} aria-hidden="true">
	<div class="ec-cart-drawer__backdrop" data-cart-drawer-close></div>
	<aside class="ec-cart-drawer__panel" role="dialog" aria-label="Shopping cart">
		<header class="ec-cart-drawer__header">
			<h2 class="ec-cart-drawer__title">Cart <span data-cart-count>(0)</span></h2>
			<button type="button" class="ec-cart-drawer__close" data-cart-drawer-close aria-label="Close cart">&times;</button>
		</header>
		<div class="ec-cart-drawer__body" data-cart-items>
			<p class="ec-cart-drawer__empty">Your cart is empty</p>
		</div>
		<footer class="ec-cart-drawer__footer" data-cart-footer style="display:none">
			<div class="ec-cart-drawer__totals">
				<div class="ec-cart-drawer__row">
					<span>Subtotal</span>
					<span data-cart-subtotal></span>
				</div>
			</div>
			<a class="ec-cart-drawer__checkout" data-cart-checkout>Checkout</a>
		</footer>
	</aside>
</div>

<style>
	.ec-cart-drawer {
		position: fixed; inset: 0; z-index: 9999;
		pointer-events: none;
		transition: visibility 0.3s;
		visibility: hidden;
	}
	.ec-cart-drawer[aria-hidden="false"] {
		pointer-events: auto;
		visibility: visible;
	}
	.ec-cart-drawer__backdrop {
		position: absolute; inset: 0;
		background: rgb(0 0 0 / 0.3);
		opacity: 0;
		transition: opacity 0.3s;
	}
	.ec-cart-drawer[aria-hidden="false"] .ec-cart-drawer__backdrop { opacity: 1; }
	.ec-cart-drawer__panel {
		position: absolute; top: 0; right: 0; bottom: 0;
		width: min(24rem, 90vw);
		background: var(--ec-color-bg, #fff);
		display: flex; flex-direction: column;
		transform: translateX(100%);
		transition: transform 0.3s ease;
		box-shadow: -4px 0 24px rgb(0 0 0 / 0.1);
	}
	.ec-cart-drawer[aria-hidden="false"] .ec-cart-drawer__panel { transform: translateX(0); }
	.ec-cart-drawer__header {
		display: flex; align-items: center; justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--ec-color-border, #e5e7eb);
	}
	.ec-cart-drawer__title { margin: 0; font-size: 1.125rem; }
	.ec-cart-drawer__close {
		border: none; background: none; font-size: 1.5rem; cursor: pointer;
		color: var(--ec-color-muted, #6b7280); padding: 0.25rem;
	}
	.ec-cart-drawer__body { flex: 1; overflow-y: auto; padding: 1rem 1.25rem; }
	.ec-cart-drawer__empty { color: var(--ec-color-muted, #6b7280); text-align: center; margin-top: 2rem; }
	.ec-cart-drawer__footer {
		padding: 1rem 1.25rem;
		border-top: 1px solid var(--ec-color-border, #e5e7eb);
	}
	.ec-cart-drawer__row {
		display: flex; justify-content: space-between;
		font-weight: 600; margin-bottom: 0.75rem;
	}
	.ec-cart-drawer__checkout {
		display: block; text-align: center;
		padding: 0.75rem; background: var(--ec-color-primary, #2563eb);
		color: var(--ec-color-on-primary, #fff); border-radius: 0.375rem; text-decoration: none;
		font-weight: 500;
	}
	.ec-cart-drawer__checkout:hover { background: var(--ec-color-primary-hover, #1d4ed8); }
</style>

<script>
	const drawer = document.querySelector<HTMLElement>("[data-cart-drawer]");
	if (drawer) {
		const currency = drawer.dataset.currency || "$";
		const checkoutPath = drawer.dataset.checkout || "/checkout";

		// Open / Close
		function open() { drawer!.setAttribute("aria-hidden", "false"); }
		function close() { drawer!.setAttribute("aria-hidden", "true"); }

		drawer.querySelectorAll("[data-cart-drawer-close]").forEach((el) =>
			el.addEventListener("click", close),
		);
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") close();
		});

		// Listen for "open cart" events
		document.addEventListener("ec:open-cart", open);
		// Also open when adding to cart
		document.addEventListener("ec:cart-updated", open);

		// Render cart state
		function fmt(cents: number): string {
			return `${currency}${(cents / 100).toFixed(2)}`;
		}

		async function initCartListener() {
			try {
				const { onCartChange, escapeHtml } = await import("@emdash-cms/plugin-emcommerce/client");
				onCartChange((cart) => {
					const countEl = drawer!.querySelector("[data-cart-count]");
					const itemsEl = drawer!.querySelector("[data-cart-items]");
					const footerEl = drawer!.querySelector<HTMLElement>("[data-cart-footer]");
					const subtotalEl = drawer!.querySelector("[data-cart-subtotal]");
					const checkoutEl = drawer!.querySelector<HTMLAnchorElement>("[data-cart-checkout]");

					if (countEl) countEl.textContent = `(${cart.itemCount})`;
					if (subtotalEl) subtotalEl.textContent = fmt(cart.subtotal);
					if (checkoutEl) checkoutEl.href = checkoutPath;

					if (footerEl) footerEl.style.display = cart.itemCount > 0 ? "" : "none";

					if (itemsEl) {
						if (cart.items.length === 0) {
							itemsEl.innerHTML = '<p class="ec-cart-drawer__empty">Your cart is empty</p>';
						} else {
							itemsEl.innerHTML = cart.items.map((item) => `
								<div style="display:flex;gap:0.75rem;padding:0.5rem 0;border-bottom:1px solid #e5e7eb">
									<div style="flex:1">
										<div style="font-weight:500">${escapeHtml(item.name)}</div>
										<div style="font-size:0.875rem;color:#6b7280">Qty: ${item.quantity}</div>
									</div>
									<div style="font-weight:500">${fmt(item.lineTotal)}</div>
								</div>
							`).join("");
						}
					}
				});
			} catch { /* Cart client not available */ }
		}
		initCartListener();
	}
</script>
